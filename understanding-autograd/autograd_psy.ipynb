   "source": [
    "# Testing out Autograd in PyTorch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5a04d8b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "cbdd9842",
   "metadata": {},
   "outputs": [],
   "source": [
    "a = torch.randn(4, 4, requires_grad=True)\n",
    "b = torch.randn(4, 4)\n",
    "\n",
    "h = a @ b\n",
    "loss = h.sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "bbd7ef34",
   "metadata": {},
   "outputs": [],
   "source": [
    "loss.backward()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "6e854ea6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "None\n"
     ]
    }
   ],
   "source": [
    "print(b.grad)"
   ]
  },
